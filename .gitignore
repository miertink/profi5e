# Assembly build artifacts (regenerable via build.sh / asm_build.sh) --
# scoped to loader/ and examples/ so rom/Profi5E.BIN (the original
# reference dump, which should stay versioned) isn't caught too.
loader/*.bin
loader/*.lst
loader/*.p
examples/*.bin
examples/*.lst
examples/*.p

# ...except the prebuilt binaries committed on purpose, so the project can
# be used (burn the loader, run the examples) with zero build tooling --
# see README.md "Just want to use it" section.
!loader/loader_2764.bin
!loader/loader_27128.bin
!examples/hiworld.bin
!examples/scroll_text.bin

# Python
__pycache__/

# Local Claude Code settings (machine-specific, not project config)
.claude/
